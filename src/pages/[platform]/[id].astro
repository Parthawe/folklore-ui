---
import Layout from '../../layouts/Layout.astro';
import Specimen from '../../components/Specimen.astro';
import {catalog,entryPath} from '../../../content/catalog.mjs';
import type {Entry} from '../../lib/types';
export function getStaticPaths(){return catalog.map(entry=>({params:{platform:entry.kind==='style'?'styles':entry.platform,id:entry.id},props:{entry}}));}
const {entry}=Astro.props as {entry:Entry};
const related=entry.related.map(id=>(catalog as Entry[]).find(e=>e.id===id)!);
---
<Layout title={`${entry.name} — Folklore`} description={entry.description} active={entry.kind==='style'?'styles':'elements'}><article class="entry-page" data-entry-id={entry.id}><div class="entry-breadcrumb"><nav aria-label="Breadcrumb"><a href={entry.kind==='style'?'/styles/':'/'}>{entry.kind==='style'?'Styles':'Elements'}</a><span aria-hidden="true">/</span><span>{entry.name}</span></nav><div class="entry-actions"><button data-save={entry.id} aria-pressed="false">Save entry</button><button data-copy-page={entry.id}>Copy Markdown</button><button data-share>Copy link</button></div></div><header class="entry-heading"><div><h1>{entry.name}<span>.</span></h1><p class="entry-definition">{entry.description}</p></div><span class="platform-label">{entry.kind==='style'?entry.status:entry.platform==='web'?'Web element':'macOS element'}</span></header><div class="detail-grid"><div class="specimen-column"><div class="detail-specimen"><Specimen entry={entry}/></div><div class="specimen-caption"><span>{entry.platform==='macos'?'Browser simulation':entry.kind==='style'?'Original visual specimen':'Working example'}</span><span>{entry.platform==='macos'?'Native behavior differs':'Try it. It’s interactive.'}</span></div><div class="anatomy-list"><h2>{entry.kind==='style'?'Recognize the signals':'Every part, named'}</h2><p>{entry.kind==='style'?'Look for the combination, rather than one isolated effect.':'Select a part to see where it belongs in the example.'}</p>{entry.anatomy.map((part,i)=><button class="anatomy-item" data-part={i} aria-pressed="false"><span class="part-number">{i+1}</span><span><strong>{part.name}</strong><code>{part.api}</code><span>{part.description}</span></span><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 5 5 5-5 5"/></svg></button>)}<p class="part-readout" role="status">{entry.kind==='style'?'Select a signal to inspect the specimen.':'Select a part to inspect the specimen.'}</p></div></div><div class="entry-text"><section><h2>You might have called it…</h2><div class="phrase-list">{entry.phrases.map(p=><span>“{p}”</span>)}</div><p class="alias-line">Also called {entry.aliases.join(', ')}.</p></section><section><h2>{entry.kind==='style'?'Build the look':'How it behaves'}</h2><p>{entry.behavior}</p></section><section class="prompt-section"><div class="section-title"><h2>A brief for your agent</h2><button data-copy-text={entry.prompt}>Copy brief</button></div><p>{entry.prompt}</p></section><section class="debug-section"><div class="section-title"><h2>When it goes wrong</h2><button data-copy-text={`Debug my ${entry.name.toLowerCase()}. ${entry.debug} My symptom: `}>Copy debug prompt</button></div><p>{entry.debug}</p></section>{entry.api.length>0&&<section><h2>In code</h2><dl class="api-list">{entry.api.map(a=><div><dt>{a.framework}</dt><dd><code>{a.symbol}</code></dd></div>)}</dl></section>}<section class="source-section"><h2>Sources & terminology</h2><p>{entry.status}. {entry.kind==='style'?'Styles are families of visual decisions; these sources document the vocabulary or provide a concrete specimen.':'API names stay attached to their platform. Check the documentation for deployment-target availability.'}</p><ul>{entry.sources.map(s=><li><a href={s.url} target="_blank" rel="noreferrer">{s.title}</a></li>)}</ul><small>Reviewed {entry.updated} · Original Folklore content</small></section></div></div><section class="related-section"><div class="section-title"><h2>Nearby in the field guide</h2><a href={`/compare/?a=${entry.id}&b=${related[0].id}`}>Compare with {related[0].name}</a></div><div class="related-list">{related.map(e=><a href={entryPath(e)}><span>{e.name}</span><p>{e.description}</p><span class="related-platform">{e.platform==='style'?'Style':e.platform}</span></a>)}</div></section></article></Layout>
