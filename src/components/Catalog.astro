---
import {withBase} from '../lib/paths.mjs';
import {catalog,entryPath} from '../../content/catalog.mjs';
import type {Entry} from '../lib/types';
import Specimen from './Specimen.astro';
const {kind='element',saved=false}=Astro.props;
const entries=(catalog as Entry[]).filter(e=>saved||e.kind===kind);
---
<section class="catalog-section" data-catalog data-kind={saved?'all':kind} data-saved={saved?'true':'false'}>
  {!saved&&<div class="search-area"><label for="catalog-search" class="sr-only">Describe the {kind==='style'?'visual style':'UI element'}</label><div class="search-box"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="catalog-search" type="search" placeholder={kind==='style'?'Describe the look you have in mind…':'Describe the thing you’re thinking of…'} autocomplete="off"/><kbd>⌘ K</kbd></div><div class="search-examples"><span>Try</span>{(kind==='style'?['soft embossed buttons','chrome and bubblegum','glossy grass and bubbles']:['dark layer behind a popup','the three dots menu','gray shapes before content loads']).map(q=><button data-query={q}>{q}</button>)}</div></div>}
  <div class="catalog-toolbar"><div class="filter-group" role="group" aria-label="Filter catalog">{saved?<span>Your bookmarks</span>:kind==='element'?<><button data-filter="all" aria-pressed="true">All elements <span>30</span></button><button data-filter="web" aria-pressed="false">Web <span>20</span></button><button data-filter="macos" aria-pressed="false">macOS <span>10</span></button></>:<span>Visual styles <span>10</span></span>}</div><div class="catalog-tools"><span class="result-count" role="status">{entries.length} entries</span><a href={withBase('/compare/')}>Compare patterns</a></div></div>
  <div class="catalog-grid">{entries.map((entry)=><article class="entry-card" data-id={entry.id} data-platform={entry.platform}><a href={withBase(entryPath(entry))} class="entry-card-link"><div class="card-specimen" aria-hidden="true" inert><Specimen entry={entry} preview/></div><div class="entry-meta"><span>{entry.kind==='style'?entry.status:entry.platform==='web'?'Web':'macOS'}</span><svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m8 5 5 5-5 5"/></svg></div><h2>{entry.name}</h2><p>{entry.description}</p><span class="matched-part" hidden></span><code>{entry.kind==='style'?entry.signals?.slice(0,2).join(' / '):entry.api[0].symbol}</code></a></article>)}</div>
  <div class="empty-results" hidden><svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="20" cy="20" r="12"/><path d="m29 29 12 12M15 20h10"/></svg><h2>{saved?'Your collection starts here.':'No close match yet.'}</h2><p>{saved?'Save an element or style from its detail page. It stays in this browser.':'Try describing where it sits, what it does, or what it looks like.'}</p><button data-clear>{saved?'Browse the field guide':'Clear search and filters'}</button></div>
</section>
