---
import {withBase} from '../lib/paths.mjs';
import type {Entry} from '../lib/types';
const {entry,preview=false}=Astro.props as {entry:Entry;preview?:boolean};
const id=entry.id;
const overlay=['dialog','drawer','sheet','scrim','mac-sheet','mac-popover','popover'].includes(id);
---
<div class:list={['specimen',`demo-${id}`,{'is-preview':preview,'is-native':entry.platform==='macos'}]} data-demo={id} data-preview={preview?'true':'false'}>
  {entry.kind==='style' ? <>
    {id==='minimalism'&&<div class="style-minimal"><span>FIELD NOTES</span><h3>A little<br/>less.</h3><p>Space for what matters.</p><button data-style-action>Explore the collection</button></div>}
    {id==='flat-design'&&<div class="style-flat"><div class="flat-art"><i></i><i></i><i></i></div><strong>Make room.</strong><p>Good things, in simple shapes.</p><button data-style-action>Discover</button></div>}
    {id==='skeuomorphism'&&<div class="style-skeuo"><div class="notebook"><div class="binding"></div><span>MONDAY</span><h3>Ideas worth<br/>keeping.</h3><p>Take the long way home.<br/>Write it all down.</p><button data-style-action>Turn the page</button></div></div>}
    {id==='neumorphism'&&<div class="style-neumo"><span>FOCUS SESSION</span><div class="soft-dial">25:00</div><strong>One thing at a time.</strong><button data-style-action aria-pressed="false">Start session</button></div>}
    {id==='glassmorphism'&&<div class="style-glass"><div class="glass-shape shape-a"></div><div class="glass-shape shape-b"></div><div class="glass-card"><span>TODAY, AT YOUR PACE</span><h3>A clear<br/>headspace.</h3><p>Somewhere between here<br/>and your next idea.</p><button data-style-action>Step inside</button></div></div>}
    {id==='web-brutalism'&&<div class="style-brutal"><h3>an unfinished<br/>internet.</h3><hr/><p>Personal documents, links,<br/>and things worth saving.</p><button data-style-action>open the index</button><p>Last edited: November 23.</p></div>}
    {id==='neobrutalism'&&<div class="style-neo"><span>INDEPENDENT IDEAS</span><h3>GOOD<br/>STUFF.</h3><button data-style-action>Take a look</button></div>}
    {id==='y2k'&&<div class="style-y2k"><span>CONNECTED TO TOMORROW</span><div class="chrome-orbit"></div><h3>hyper<br/>space</h3><button data-style-action>ENTER SYSTEM</button></div>}
    {id==='frutiger-aero'&&<div class="style-aero"><div class="aero-sun"></div><div class="aero-hill"></div><i class="bubble b1"></i><i class="bubble b2"></i><div class="aero-content"><span>A FRESH PERSPECTIVE</span><h3>Hello,<br/>tomorrow.</h3><button data-style-action>Explore outside</button></div></div>}
    {id==='swiss-style'&&<div class="style-swiss"><div class="swiss-title"><span>Form.<br/>Function.<br/>Feeling.</span></div><div class="swiss-circle"></div><div class="swiss-bottom"><strong>Design in order.</strong><button data-style-action>View studies</button></div></div>}
  </> : <>
    {overlay&&<div class:list={['overlay-workspace',{'engineered-workspace':id==='scrim'&&!preview}]}>
      {id==='scrim'&&!preview ? <><div class="reference-chrome"><span class="reference-app-mark" aria-hidden="true">f</span><strong>Reference library</strong><span class="reference-path">Collection / Interface studies</span><span class="reference-avatar">JD</span></div><div class="reference-sidebar"><span>Library</span><b>All references <small>12</small></b><span>Collections</span><span>Recently added</span><div class="reference-library-note">EXAMPLE WORKSPACE</div></div><div class="reference-content"><div class="reference-content-title"><h3>Interface studies</h3><span>12 references</span></div><div class="reference-covers">{['Structure','Typography','Interaction'].map((name,i)=><div class="reference-cover"><div class:list={['reference-art',`reference-art-${i}`]} aria-hidden="true"><i></i><i></i><i></i></div><strong>{name}</strong><span>Design reference</span></div>)}</div></div></> : <>
      <div class="sample-top"><span class="sample-dot"></span><strong>Studio</strong><span class="sample-line"></span><span class="mini-avatar">A</span></div>
      <div class="sample-sidebar"><span>Overview</span><span>Projects</span><span>Archive</span></div><div class="sample-content"><small>YOUR WORKSPACE</small><h3>Make a little<br/>room for ideas.</h3><div class="sample-lines"><i></i><i></i><i></i></div></div>
      </>}
      <button class="demo-launch" data-open>Open {entry.name.toLowerCase()}</button>
      {preview?<div class="preview-scrim"><div class="overlay-card"><span class="demo-caption">{id==='scrim'?'The page steps back.':'A space for the task.'}</span><strong>{id==='mac-popover'||id==='popover'?'A closer look':'Keep this idea?'}</strong><p>Give it a place in your collection.</p><div class="demo-actions"><span>Cancel</span><b>Save idea</b></div></div></div>:<dialog class="overlay-card" aria-label={`${entry.name} example`}><form method="dialog">{id==='scrim'?<><div class="reference-dialog-header"><svg width="40" height="44" viewBox="0 0 40 44" fill="none" aria-hidden="true"><rect x="3" y="2" width="33" height="39" rx="5" stroke="currentColor"/><rect x="9" y="9" width="21" height="12" rx="2" fill="currentColor" fill-opacity=".1" stroke="currentColor"/><path d="M10 28h19M10 33h12" stroke="currentColor"/></svg><div><span class="demo-caption">Interactive specimen</span><h3>Save this reference?</h3></div></div><div class="reference-destination"><span>Collection</span><strong>Interface studies</strong></div><p>This demonstration keeps changes in the example.</p></>:<><span class="demo-caption">Interactive example</span><h3>Save this example?</h3><p>Try saving or canceling this dialog.</p></>}<div class="demo-actions"><button value="cancel">Cancel</button><button value="save" class="demo-primary">Save idea</button></div></form></dialog>}
    </div>}
    {id==='tooltip'&&<div class="tooltip-scene"><p>A little context, right on cue.</p><div class="tip-wrap"><button aria-describedby="tip-description" class="tip-trigger">Archive project</button><span role="tooltip" id="tip-description">Keep it, without the clutter.</span></div><small>Hover or focus the button</small></div>}
    {id==='dropdown-menu'&&<div class="menu-scene"><div class="demo-file"><span class="document-icon"></span><div><strong>Field notes</strong><small>Edited just now</small></div><button data-menu-trigger aria-haspopup="menu" aria-expanded="false" aria-label="Project actions"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><circle cx="4" cy="10" r="1.5"/><circle cx="10" cy="10" r="1.5"/><circle cx="16" cy="10" r="1.5"/></svg></button></div><div class="action-menu" role="menu" aria-label="Project actions"><button role="menuitem">Rename</button><button role="menuitem">Duplicate</button><button role="menuitem">Archive</button></div><p class="demo-result" role="status"></p></div>}
    {id==='combobox'&&<div class="combo-scene"><label for={`fruit-${preview?'preview':'full'}`}>Find a material</label><input id={`fruit-${preview?'preview':'full'}`} role="combobox" aria-expanded="false" aria-controls={`materials-${preview?'preview':'full'}`} aria-autocomplete="list" placeholder="Try ‘cotton’" autocomplete="off"/><ul id={`materials-${preview?'preview':'full'}`} role="listbox" aria-label="Materials" class="combo-options" hidden></ul><small>Suggestions, as you type.</small></div>}
    {id==='command-palette'&&<div class="command-scene">{preview?<div class="command-card"><div class="command-input"><span class="search-glyph"></span>What would you like to do?</div><small>SUGGESTED ACTIONS</small><div class="command-option"><span>Create a new project</span><kbd>↵</kbd></div><div class="command-option"><span>Open the library</span></div><div class="command-option"><span>Change appearance</span></div></div>:<><button data-command-open>Open command palette <kbd>⌘ K</kbd></button><dialog class="command-card" aria-label="Command palette"><label class="sr-only" for="command-query">Find an action</label><input id="command-query" role="combobox" aria-expanded="true" aria-controls="command-options" aria-autocomplete="list" placeholder="What would you like to do?" autocomplete="off"/><ul id="command-options" role="listbox" aria-label="Commands"></ul><form method="dialog"><button>Close palette</button></form></dialog><p class="demo-result" role="status"></p></>}</div>}
    {id==='tabs'&&<div class="tabs-scene"><div role="tablist" aria-label="Project information">{['Overview','Activity','Settings'].map((t,i)=><button role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{t}</button>)}</div>{['A place for your next idea.','Your project is up to date.','Everything, just as you like it.'].map((t,i)=><div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i!==0} tabindex="0"><div class="panel-art"><i></i><i></i><i></i></div><strong>{t}</strong><p>One shared space. A different perspective.</p></div>)}</div>}
    {id==='accordion'&&<div class="accordion-scene">{[['What is a pattern?','A reusable solution to a recurring interface problem.'],['Why name the parts?','Shared vocabulary makes a design easier to discuss and build.'],['Can I take this offline?','Yes. The Folklore skill includes the full text catalog.']].map(([q,a],i)=><details open={preview&&i===0}><summary>{q}<span class="disclosure-chevron"></span></summary><p>{a}</p></details>)}</div>}
    {id==='toast'&&<div class="toast-scene"><div class="little-project"><div class="project-graphic"></div><strong>A small collection</strong><span>A home for things worth keeping.</span><button data-toast>Save changes</button></div><div class="sample-toast" role="status">Changes saved to your collection.</div></div>}
    {id==='form-field'&&<form class="field-scene" novalidate><label for="example-email">Email address</label><input id="example-email" name="email" type="email" placeholder="you@studio.com" aria-describedby="email-help" required/><p id="email-help">Use an address you can access.</p><button type="submit">Check address</button><p class="demo-result" role="status"></p></form>}
    {id==='data-table'&&<div class="table-scene"><table><caption>Project collection</caption><thead><tr><th scope="col" aria-sort="none"><button data-sort>Project <span>↕</span></button></th><th scope="col">Status</th><th scope="col">Type</th></tr></thead><tbody>{[['Field notes','In progress','Research'],['Good company','Complete','Identity'],['A quieter place','In review','Website']].map(([a,b,c])=><tr><th scope="row">{a}</th><td><span>{b}</span></td><td>{c}</td></tr>)}</tbody></table></div>}
    {id==='pagination'&&<div class="pagination-scene"><span>THE COLLECTION</span><h3>A few good things.</h3><div class="page-objects"><i></i><i></i><i></i></div><nav aria-label="Example pages"><button data-page-delta="-1" disabled>Previous</button>{[1,2,3].map(n=><button data-page={n} aria-label={`Page ${n}`} aria-current={n===1?'page':undefined}>{n}</button>)}<button data-page-delta="1">Next</button></nav><p class="page-status" role="status">Page 1 of 3</p></div>}
    {id==='breadcrumbs'&&<div class="breadcrumbs-scene"><nav aria-label="Example breadcrumb"><ol><li>{preview?<span>Library</span>:<a href={withBase('/')}>Library</a>}</li><li>{preview?<span>Elements</span>:<a href={withBase('/?platform=web')}>Elements</a>}</li><li aria-current="page">Breadcrumbs</li></ol></nav><span class="document-icon"></span><h3>You are here.</h3><p>Every page has a place.</p></div>}
    {id==='skeleton'&&<div class="skeleton-scene"><div data-loading-area aria-busy="true"><div class="skeleton-image"></div><div class="skeleton-line long"></div><div class="skeleton-line"></div><span class="sr-only">Loading example content</span></div><p class="loading-result" role="status">Ready to simulate a result.</p><div class="loading-controls"><button data-load="success">Load content</button><button data-load="error">Simulate error</button><button data-load="reset">Reset</button></div></div>}
    {id==='spinner'&&<div class="spinner-scene"><div data-loading-area><span class="spinner-mark" aria-hidden="true"></span></div><p class="loading-result" role="status">Waiting for your next idea.</p><div class="loading-controls"><button data-load="success">Finish loading</button><button data-load="error">Simulate error</button><button data-load="reset">Reset</button></div></div>}
    {id==='carousel'&&<div class="carousel-scene" role="region" aria-roledescription="carousel" aria-label="Color studies"><div class="carousel-image" role="group" aria-roledescription="slide" aria-label="1 of 3"><div class="landscape-sun"></div><div class="landscape-hill"></div><span>A study in blue</span></div><div class="carousel-controls"><button data-slide="-1" aria-label="Previous slide">Previous</button><span class="slide-status" aria-live="polite">1 / 3</span><button data-slide="1" aria-label="Next slide">Next</button></div></div>}
    {id==='segmented-control'&&<div class="segment-scene"><fieldset><legend>View your calendar</legend><div>{['Day','Week','Month'].map((t,i)=><label><input type="radio" name="calendar-view" value={t} checked={i===1}/><span>{t}</span></label>)}</div></fieldset><div class="calendar-lines"><i></i><i></i><i></i><i></i><i></i></div><p class="demo-result" role="status">Week view selected.</p></div>}
    {['window','toolbar','sidebar','inspector','vibrancy'].includes(id)&&<div class="mac-window"><div class="mac-titlebar"><div class="traffic-lights"><button aria-label="Close example window" data-window="close"></button><button aria-label="Minimize example window" data-window="minimize"></button><button aria-label="Zoom example window" data-window="zoom"></button></div><strong>Field notes</strong><button data-native-toggle>{id==='inspector'?'Inspector':id==='vibrancy'?'Material':'Sidebar'}</button></div><div class="mac-body"><aside><small>LIBRARY</small>{['All notes','Ideas','Favorites'].map((t,i)=><button class:list={{selected:i===0}} data-native-nav>{t}</button>)}</aside><div class="mac-document"><span>MONDAY, NOVEMBER 23</span><h3>Room to think.</h3><p>A thought, a sketch,<br/>a beginning.</p><div class="sample-lines"><i></i><i></i></div></div>{id==='inspector'&&<div class="mac-inspector"><strong>Text</strong><label>Size<input type="range" min="16" max="36" value="25" aria-label="Example text size"/></label></div>}</div><button data-window="restore" class="restore-window">Restore example</button></div>}
    {id==='menu-bar'&&<div class="menubar-scene"><div role="menubar" aria-label="Example application menu">{['Studio','File','Edit','View'].map(t=><button role="menuitem" aria-haspopup="menu" aria-expanded="false">{t}</button>)}</div><div class="native-menu" role="menu" aria-label="Example commands"><button role="menuitem">New note <kbd>⌘ N</kbd></button><button role="menuitem">Open collection <kbd>⌘ O</kbd></button><button role="menuitem">Close window <kbd>⌘ W</kbd></button></div><h3>The whole app,<br/>within reach.</h3><p class="demo-result" role="status"></p></div>}
    {id==='status-item'&&<div class="status-scene"><div class="status-menubar"><span>Studio</span><button aria-label="Open notes status item" data-status-trigger aria-expanded="false"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 3h12v14H4zM7 7h6M7 10h6M7 13h3"/></svg></button><span>9:41</span></div><div class="status-pop"><small>QUICK NOTE</small><textarea aria-label="Quick note" placeholder="Catch a passing thought…"></textarea><button data-status-save>Keep note</button><p role="status"></p></div></div>}
    {id==='dock-badge'&&<div class="dock-scene"><div class="dock-tile"><svg width="58" height="58" viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="3"><path d="M16 12h28v36H16zM23 22h14M23 30h14M23 38h7"/></svg><span class="dock-count">3</span></div><strong>A little heads-up.</strong><button data-badge>Clear unread count</button></div>}
  </>}
  {!preview&&<p class="specimen-feedback" role="status"></p>}
</div>
