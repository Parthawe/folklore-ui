---
import {catalog} from '../../../content/catalog.mjs';
import type {Entry} from '../../lib/types';
import Specimen from '../../components/Specimen.astro';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/600.css';
import '../../styles/global.css';
export function getStaticPaths(){return catalog.map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props as {entry:Entry};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>{entry.name} specimen — Folklore</title></head><body class="specimen-host"><main aria-label={`${entry.name} example`}><Specimen entry={entry}/></main><div hidden>{entry.anatomy.map((p,i)=><button data-part={i}><span><strong>{p.name}</strong><span>{p.description}</span></span></button>)}<p class="part-readout"></p></div><script>import '../../scripts/app';</script><style is:global>.specimen-host{font-family:Work Sans,sans-serif;margin:0;background:#e7ebe8;height:100vh;overflow:hidden}.specimen-host>main{height:100%;width:100%}.specimen-host .overlay-card[open]:not(:modal){position:absolute;inset:50% auto auto 50%;margin:0;transform:translate(-50%,-50%)}.specimen-host .demo-drawer .overlay-card[open]:not(:modal){inset:0 0 0 auto;transform:none}.specimen-host .demo-sheet .overlay-card[open]:not(:modal){inset:auto 0 0;transform:none}.specimen-host .overlay-card:modal{max-width:85%;width:350px}.specimen-host .specimen-feedback{font-size:13px}.specimen-host [data-demo=scrim][data-inspect="0"] dialog::backdrop{background:#1e342fc2}.specimen-host [data-demo=scrim][data-inspect="1"] dialog::backdrop{backdrop-filter:blur(8px)}.specimen-host [data-demo=scrim][data-inspect="2"] dialog{outline:3px solid #c4dc70;outline-offset:8px}</style></body></html>
