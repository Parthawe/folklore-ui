---
import {withBase} from '../lib/paths.mjs';
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/600.css';
import '../styles/global.css';
import '../styles/desk.css';
const {title='Folklore — a field guide to interfaces',description='Find the name for what you have in mind. A visual field guide to UI elements and styles, with working examples and an offline Codex skill.',active='elements',desk=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#111110"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><link rel="canonical" href={canonical}/><link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml"/><title>{title}</title><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('folklore-theme-v3')||'dark'}catch{}</script></head><body class:list={{'desk-layout':desk}}><!-- Direction: user-requested designwhich.works reference. Dark warm canvas, delicate serif display, restrained floating navigation and generous specimen framing. Keep the searchable specimen desk; remove slogan repetition and tiny controls. --><a href="#main" class="skip-link">Skip to content</a><header class="site-header"><a class="brand" href={withBase('/')} aria-label="Folklore home"><svg width="28" height="30" viewBox="0 0 28 30" fill="none" aria-hidden="true"><path d="M3 5 13 2v22L3 27V5Zm12 0 10-3v22l-10 3V5Z" fill="currentColor"/></svg><span>folklore<span class="brand-period">.</span></span></a><nav aria-label="Main navigation"><a href={withBase('/')} aria-current={active==='elements'?'page':undefined}>Elements</a><a href={withBase('/styles/')} aria-current={active==='styles'?'page':undefined}>Styles</a><a href={withBase('/saved/')} aria-current={active==='saved'?'page':undefined}>Saved<span class="saved-count"></span></a></nav><div class="header-actions"><button class="theme-toggle" aria-label="Switch color theme"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="M10 3.5v13"/></svg></button><a href={withBase('/install/')} class="install-link">Get the skill <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 2v8M4 7l4 4 4-4M3 12v2h10v-2"/></svg></a></div></header><main id="main"><slot/></main><footer class="site-footer"><a class="footer-brand" href={withBase('/')}>folklore.</a><p>UI vocabulary, with working examples.</p><nav aria-label="Footer"><a href={withBase('/saved/')}>Saved entries</a><a href={withBase('/about/')}>About & sources</a><a href="https://github.com/Parthawe/folklore-ui">GitHub</a><a href={withBase('/privacy/')}>Privacy</a><a href={withBase('/license/')}>License</a></nav><span class="footer-version">© 2026 Parth Pawar · <a href={withBase('/license/')}>MIT License</a></span></footer><div class="global-status sr-only" role="status"></div><script>import '../scripts/app';</script></body></html>
